      "type": "boolean"
    },
    "timestamp": {
      "type": "integer"
    },
    "base": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "rates": {
      "type": "object",
      "properties": {
        "INR": {
          "type": "number"
        }
      },
      "required": [
